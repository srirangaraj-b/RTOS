
/ {
    my_adc: zephyr,user {
        io-channels = <&adc 2>, <&adc 1>;
        io-channel-names = "a1", "a2";
    };

    aliases {
        my-adc = &my_adc;
    };
};



&adc {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};