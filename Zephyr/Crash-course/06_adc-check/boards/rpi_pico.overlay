/{
    myadcs: zephyr,user{
        io-channels = <&adc 1>, <&adc 2>;
        io-channel-names = "temp", "pot" ;
    };

    aliases{
        myadc = &myadcs;  
    };
};

&adc{
    #size-cells = <0>;
    #address-cells = <1>;
    status = "okay";

    channel@1{
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    channel@2{
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};